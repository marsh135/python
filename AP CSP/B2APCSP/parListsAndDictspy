print("Welcome to the B2 Diner!")
print("~"*25)

dinerMenu = {
    "Bacon": 4.00,
    "Eggs": .75,
    "Spaghetti": 8.00,
    "Hamburger": 6.00
}
running = True
while running: 
    print("")
    for item in dinerMenu:
        print(item)
    selection = input("What would you like: ").strip().capitalize()
    if selection in dinerMenu:
        print("The", selection, "costs $"+ str(dinerMenu[selection]))
    else:
        print("We do not have", selection)
    done = input("Does that complete your order: (Y/N)").strip().upper()
    if done == "Y":
        running = False

print("We will get that started for you!")

